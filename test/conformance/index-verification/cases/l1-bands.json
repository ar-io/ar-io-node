  {
    "id": "l1-bands-wallets-links",
    "description": "A2: a wallet's key replaced and every link dropped, band.json left as published",
    "tampered": "wallets.public_modulus, block_transactions emptied",
    "kind": "l1-bands",
    "options": {
      "allowUnanchored": true
    },
    "ops": [
      {
        "op": "forgeWallet",
        "band": 0
      },
      {
        "op": "rewrite",
        "band": 0,
        "table": "block_transactions",
        "select": "SELECT * FROM SRC WHERE false"
      }
    ],
    "expect": {
      "verdict": "refuted",
      "check": "tables",
      "failing": [
        "tables",
        "position",
        "tx_count",
        "wallets"
      ]
    }
  },
