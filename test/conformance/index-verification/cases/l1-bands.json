  {
    "id": "l1-bands-honest",
    "description": "Two sound bands of a verifiable chain, checked without an anchor, which is accepted",
    "tampered": "nothing",
    "kind": "l1-bands",
    "options": {
      "allowUnanchored": true
    },
    "expect": {
      "verdict": "verified",
      "failing": []
    }
  },
  {
    "id": "l1-bands-unanchored",
