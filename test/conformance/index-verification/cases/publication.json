[
  {
    "id": "bands-honest-publication",
    "description": "Sound bands bound to the publisher's signed publication",
    "tampered": "nothing",
    "kind": "bands",
    "bands": [
      {
        "from": 100,
        "to": 199,
        "publisher": "wallet"
      },
      {
        "from": 200,
        "to": 299,
        "publisher": "wallet"
      }
    ],
    "publication": {},
    "expect": {
      "verdict": "verified",
      "publisherBound": true
    }
  },
  {
    "id": "bands-honest-publication-expired-allowed",
    "description": "Sound bands bound to an expired publication, expiry allowed",
    "tampered": "publication expired",
    "kind": "bands",
    "bands": [
      {
        "from": 100,
        "to": 199,
        "publisher": "wallet"
      }
    ],
    "publication": {
      "expiresAt": "2020-01-01T00:00:00Z",
      "issuedAt": "2019-12-31T00:00:00Z"
    },
    "options": {
      "allowExpired": true
    },
    "expect": {
      "verdict": "verified",
      "publisherBound": true
    }
  },
  {
    "id": "pub-band-json-edit",
    "description": "band.json edited after signing (checks only, outside the id)",
    "tampered": "checks.ownersWithoutKey raised",
    "kind": "bands",
    "bands": [
      {
        "from": 100,
        "to": 199,
        "publisher": "wallet"
      }
    ],
    "files": [
      {
        "op": "editBandJson",
        "band": 0,
        "checks": {
          "ownersWithoutKey": 5
        }
      }
    ],
    "publication": {},
    "expect": {
      "verdict": "refuted",
      "check": "publication",
      "failing": [
        "publication"
      ]
    }
  },
