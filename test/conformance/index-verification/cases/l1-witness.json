        "op": "witnessV1",
        "band": 0,
        "height": 1900001,
        "bti": 0,
        "root": "leaf"
      },
      {
        "op": "rewrite",
        "band": 0,
        "table": "transactions",
        "select": "SELECT * REPLACE (CASE WHEN height = 1900001 AND block_transaction_index = 0 THEN from_hex(repeat('de', 32)) ELSE data_root END AS data_root) FROM SRC"
