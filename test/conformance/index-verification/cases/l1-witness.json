  {
    "id": "l1-anchor-witness-relabel-sampled",
    "description": "l1-4: a format-2 transaction relabelled format 1 and given its own data_root as a witness passes tx_root, so the band verifies on its own; the format-1 draw still catches it by its signature",
    "tampered": "transactions.format, a witness_v1_data_roots row (its tx_root leaf), data_root cleared, republished",
    "kind": "l1-anchor",
    "nodes": [
      {
        "name": "a",
        "answer": "honest"
      },
      {
        "name": "b",
        "answer": "honest"
      }
    ],
    "options": {
      "sample": {
        "blocks": 2,
        "txs": 0,
        "format1": 5
      }
    },
    "ops": [
      {
        "op": "setFormat",
        "band": 1,
        "height": 1900013,
        "bti": 0,
        "format": 1
      },
      {
        "op": "witnessV1",
        "band": 1,
        "height": 1900013,
        "bti": 0,
        "root": "leaf"
      },
      {
        "op": "republish",
        "band": 1
      }
    ],
    "expect": {
      "verdict": "refuted",
      "check": "sample",
      "failing": [
        "sample"
      ],
      "anchored": true
    }
  },
