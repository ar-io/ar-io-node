#!/usr/bin/env bash
# Quick session-start health snapshot for an AR.IO gateway.
#
# Covers only the core ar-io-node containers (gateway core, ClickHouse,
# auto-import) defined in this repo's docker-compose. Sidecar / deployment
# extensions belong in a separate deployment-overlay skill that calls this
# script first and then adds its own checks.
#
# Useful env knobs (all optional):
#   AR_IO_NODE_PATH                  (default: /programs/ar-io-node)
#   DATA_MOUNT_PATH                  (default: /data — set empty to skip extra disk check)
#   CORE_CONTAINER                   (default: ar-io-node-core-1)
#   CH_CONTAINER                     (default: ar-io-node-clickhouse-1)
#   CH_AUTO_IMPORT_CONTAINER         (default: ar-io-node-clickhouse-auto-import-1)
#   GATEWAY_HEALTH_URL               (default: http://localhost:4000/ar-io/healthcheck)
#   CHAIN_INFO_URL                   (default: https://arweave.net/info)
set -uo pipefail

AR_IO_NODE_PATH="${AR_IO_NODE_PATH:-/programs/ar-io-node}"
DATA_MOUNT_PATH="${DATA_MOUNT_PATH:-/data}"
CORE_CONTAINER="${CORE_CONTAINER:-ar-io-node-core-1}"
CH_CONTAINER="${CH_CONTAINER:-ar-io-node-clickhouse-1}"
CH_AUTO_IMPORT_CONTAINER="${CH_AUTO_IMPORT_CONTAINER:-ar-io-node-clickhouse-auto-import-1}"
GATEWAY_HEALTH_URL="${GATEWAY_HEALTH_URL:-http://localhost:4000/ar-io/healthcheck}"
CHAIN_INFO_URL="${CHAIN_INFO_URL:-https://arweave.net/info}"
SQLITE_DB="${SQLITE_DB:-$AR_IO_NODE_PATH/data/sqlite/core.db}"

section() { printf '\n=== %s ===\n' "$1"; }

section "containers"
docker ps --format '{{.Names}}\t{{.Status}}' | sort

section "disk"
df -h / 2>/dev/null
[[ -n "$DATA_MOUNT_PATH" && -d "$DATA_MOUNT_PATH" ]] && df -h "$DATA_MOUNT_PATH" 2>/dev/null

section "gateway healthcheck"
if curl -sf -m 3 "$GATEWAY_HEALTH_URL"; then echo; else echo 'UNHEALTHY or unreachable'; fi

section "indexer height vs chain head"
local_h=$(sqlite3 "$SQLITE_DB" \
  "SELECT MAX(MAX(height), (SELECT MAX(height) FROM stable_blocks)) FROM new_blocks" 2>/dev/null)
chain_h=$(curl -sf -m 5 "$CHAIN_INFO_URL" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("height",""))' 2>/dev/null)
echo "local: ${local_h:-?}  chain: ${chain_h:-?}"
if [[ "$local_h" =~ ^[0-9]+$ && "$chain_h" =~ ^[0-9]+$ ]]; then
  lag=$((chain_h - local_h))
  echo "lag (blocks): $lag  ($([ $lag -le 5 ] && echo OK || echo BEHIND))"
else
  echo "lag: skipped (non-numeric height; local='${local_h}' chain='${chain_h}')"
fi

section "clickhouse rows + max heights"
if docker ps --format '{{.Names}}' | grep -q "^${CH_CONTAINER}$"; then
  docker exec "$CH_CONTAINER" clickhouse-client --query \
    "SELECT 'transactions' t, count() rows, max(height) h FROM transactions
     UNION ALL SELECT 'staging_transactions', count(), max(height) FROM staging_transactions
     UNION ALL SELECT 'new_blocks', count(), max(height) FROM new_blocks
     UNION ALL SELECT 'new_transactions', count(), max(height) FROM new_transactions
     FORMAT TSV" 2>/dev/null || echo 'CH query failed'
else
  echo 'ClickHouse not running (no --profile clickhouse?)'
fi

section "core errors in last 5 minutes"
if docker ps --format '{{.Names}}' | grep -q "^${CORE_CONTAINER}$"; then
  docker logs --since=5m "$CORE_CONTAINER" 2>&1 \
    | grep -viE '"buffer":|raw bytes|^[\[0-9, ]+$' \
    | grep -ciE '"level":"error"|^[^|]*\| error:'
else
  echo "$CORE_CONTAINER not running"
fi

section "image SHAs (compare against ghcr digest if on a dev branch)"
for c in "$CORE_CONTAINER" "$CH_CONTAINER" "$CH_AUTO_IMPORT_CONTAINER"; do
  if docker ps --format '{{.Names}}' | grep -q "^${c}$"; then
    printf '%-40s %s\n' "$c" "$(docker inspect "$c" --format '{{.Image}}')"
  fi
done
