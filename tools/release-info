#
# Print release-related state from the working tree.
#
# Usage:
#   ./tools/release-info          # human-readable
#   ./tools/release-info --json   # JSON output
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

exec node --import ./register.js tools/lib/release/release-info.ts "$@"
