# Queue Missing Bundles
#
# Reads a CSV of (data_item_id, bundle_id, ...) rows, checks which data items
# are missing from ClickHouse, and queues the associated bundles for indexing
# on the ar-io-node core service. Streams the CSV so it handles very large
# inputs, deduplicates bundle ids across the run, and waits on HTTP 429 when
# the bundle importer queue is full.
#
# Usage: ./tools/queue-missing-bundles --input <csv> [options]
# Run with --help for all options.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

# Let Node parse .env directly so values with JSON/array contents don't have to
# be shell-safe (bash `source` chokes on unquoted `FOO={"a": 1, "b": 2}`).
env_file_args=()
if [ -f .env ]; then
  env_file_args=(--env-file=.env)
fi

exec node "${env_file_args[@]}" --import ./register.js tools/lib/queue-missing-bundles.ts "$@"
