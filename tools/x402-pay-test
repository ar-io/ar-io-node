#!/usr/bin/env node
/**
 * x402-pay-test — close the last unverified link in the payment path.
 *
 * `tools/x402-probe` proves the gateway ASKS for payment. This proves the ask
 * can be ANSWERED: it drives a real wallet through 402 -> sign -> retry -> 200,
 * and reports what the gateway actually settled on chain.
 *
 * It spends real USDC on Base mainnet. The amount is derived from response size
 * (~$0.004 for a 36 MB object) and is capped below, so a pricing bug cannot
 * drain the wallet.
 *
 * The signing wallet is a throwaway kept outside the repo:
 *   ~/.config/ar-io-x402/test-wallet.key   (0600)
 * Never point this at the receiving wallet — payer and payTo being the same
 * address is a self-transfer and proves nothing about a real customer's path.
 *
 * Usage:  tools/x402-pay-test [tx-id]
 * Env:    GATEWAY (default http://localhost:3000)
 *         X402_KEY_FILE (default ~/.config/ar-io-x402/test-wallet.key)
 *         MAX_USDC (default 0.05 — hard ceiling on a single payment)
 */

import { readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { createWalletClient, http, publicActions, formatUnits } from 'viem';
import { privateKeyToAccount } from 'viem/accounts';
import { base } from 'viem/chains';
import { wrapFetchWithPayment, decodeXPaymentResponse } from 'x402-fetch';

const TX = process.argv[2] ?? 'hhOoYZtHBqQi3d-dmxcGooXKTbiT3HJ2-eNsE7HNtKg';
const GATEWAY = process.env.GATEWAY ?? 'http://localhost:3000';
const KEY_FILE =
  process.env.X402_KEY_FILE ?? join(homedir(), '.config/ar-io-x402/test-wallet.key');
const MAX_USDC = Number(process.env.MAX_USDC ?? '0.05');
const USDC_BASE = '0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913';
const TEST_IP = '203.0.113.99'; // TEST-NET-3; the probe drains this bucket

const say = (...a) => console.log(...a);

const key = readFileSync(KEY_FILE, 'utf8').trim();
const account = privateKeyToAccount(key);
const wallet = createWalletClient({ account, chain: base, transport: http() }).extend(
  publicActions,
);

say('== x402 payment test ==');
say(`   gateway : ${GATEWAY}`);
say(`   payer   : ${account.address}`);
say(`   tx      : ${TX}`);

// --- funding check -----------------------------------------------------------
const balance = await wallet.readContract({
  address: USDC_BASE,
  abi: [
    {
      name: 'balanceOf',
      type: 'function',
      stateMutability: 'view',
      inputs: [{ name: 'a', type: 'address' }],
      outputs: [{ type: 'uint256' }],
    },
  ],
  functionName: 'balanceOf',
  args: [account.address],
});
const usdc = Number(formatUnits(balance, 6));
say(`   balance : ${usdc} USDC on Base`);
if (usdc <= 0) {
  say('\n!! wallet holds no USDC — fund it and re-run.');
  say('   Payment uses EIP-3009 (gasless for the payer), so it needs USDC only, no ETH.');
  process.exit(1);
}

// --- 1. unpaid request must be refused --------------------------------------
const url = `${GATEWAY}/raw/${TX}`;
const headers = { 'X-Forwarded-For': TEST_IP, Accept: 'application/json' };

const unpaid = await fetch(url, { headers });
say(`\n-- unpaid request        HTTP ${unpaid.status}   expect 402`);
if (unpaid.status !== 402) {
  say('   !! bucket is not exhausted; run tools/x402-probe first to drain it');
  process.exit(1);
}
const reqs = await unpaid.json();
const need = reqs.accepts?.[0];
say(`   asking ${need?.maxAmountRequired} atomic USDC on ${need?.network} -> ${need?.payTo}`);

if (need?.payTo?.toLowerCase() === account.address.toLowerCase()) {
  say('   !! payer === payTo. That is a self-transfer and proves nothing. Aborting.');
  process.exit(1);
}

// --- 2. pay and retry --------------------------------------------------------
const maxAtomic = BigInt(Math.round(MAX_USDC * 1e6));
say(`\n-- paying (ceiling ${MAX_USDC} USDC) ...`);
const payFetch = wrapFetchWithPayment(fetch, wallet, maxAtomic);

const started = Date.now();
const paid = await payFetch(url, { headers });
const elapsed = ((Date.now() - started) / 1000).toFixed(1);

say(`-- paid request          HTTP ${paid.status}   (${elapsed}s)`);
const settled = paid.headers.get('x-payment-response');
if (settled) {
  try {
    const d = decodeXPaymentResponse(settled);
    say(`   settlement: success=${d.success} tx=${d.transaction ?? 'n/a'} network=${d.network ?? 'n/a'}`);
  } catch {
    say(`   settlement header present (undecodable): ${settled.slice(0, 80)}`);
  }
} else {
  say('   !! no X-Payment-Response header — settlement not reported');
}

const bytes = Number(paid.headers.get('content-length') ?? 0);
say(`   content-type: ${paid.headers.get('content-type')}  bytes: ${bytes}`);

// --- 3. what it cost ---------------------------------------------------------
const after = await wallet.readContract({
  address: USDC_BASE,
  abi: [
    {
      name: 'balanceOf',
      type: 'function',
      stateMutability: 'view',
      inputs: [{ name: 'a', type: 'address' }],
      outputs: [{ type: 'uint256' }],
    },
  ],
  functionName: 'balanceOf',
  args: [account.address],
});
const spent = Number(formatUnits(balance - after, 6));
say(`   spent: ${spent} USDC   (balance now ${Number(formatUnits(after, 6))})`);

const ok = paid.status === 200 && bytes > 0;
say(`\n== ${ok ? 'PASS — 402 answered, data served' : 'FAIL — see above'} ==`);
process.exit(ok ? 0 : 1);
