#
# Set up index sharing (the index-swarm sidecar and its torrent engine, which
# run by default) further in .env, then optionally restart what the changes
# need. Idempotent: run it again to add a publisher.
#
# Usage (from the gateway's directory, where .env and docker-compose.yaml are):
#   ./tools/index-swarm-setup --subscribe <publisher wallet> --restart
#   ./tools/index-swarm-setup --publish --public-host <ip> --restart
#   ./tools/index-swarm-setup --help
#
# The .env logic runs in the core image (CORE_IMAGE_TAG), so the host needs
# only Docker. --restart recreates, by service name, only what the changes
# need, using the same compose files the running gateway was started with,
# and never a service those files turn off (an engine behind a profile).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}/.."

ENV_FILE=".env"
RESTART=false
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --restart) RESTART=true; ARGS+=("$1") ;;
    --env-file) ENV_FILE="$2"; shift ;;
    --env-file=*) ENV_FILE="${1#--env-file=}" ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
# The file itself, not a link to it: only its directory is mounted into the
# container, so a link (tools/wt makes .env one) would point nowhere there.
if [[ -e "${ENV_FILE}" ]]; then
  ENV_REAL="$(realpath -e "${ENV_FILE}")"
else
  ENV_REAL="$(realpath -m "${ENV_FILE}")"
  if [[ -L "${ENV_FILE}" ]]; then
    echo "index-swarm-setup: ${ENV_FILE} is a link to a missing file (${ENV_REAL})" >&2
    exit 1
  fi
fi
ENV_DIR="$(dirname "${ENV_REAL}")"
ENV_NAME="$(basename "${ENV_REAL}")"

# The image the gateway runs, so the tool matches its release.
TAG="$(sed -n 's/^CORE_IMAGE_TAG=//p' "${ENV_FILE}" 2>/dev/null | tail -n1 | tr -d "'\"" || true)"
IMAGE="${INDEX_SWARM_SETUP_IMAGE:-ghcr.io/ar-io/ar-io-core:${TAG:-latest}}"

if ! probe="$(docker run --rm --entrypoint /nodejs/bin/node "${IMAGE}" \
  -e "require('fs').accessSync('/app/dist/index-swarm/cli/setup.js')" 2>&1)"; then
  if grep -q "no such file or directory, access" <<<"${probe}"; then
    echo "index-swarm-setup: ${IMAGE} predates this tool." >&2
    echo "Set CORE_IMAGE_TAG to a release that has it, or run with INDEX_SWARM_SETUP_IMAGE=<image>." >&2
  else
    echo "index-swarm-setup: could not run ${IMAGE}:" >&2
    echo "${probe}" >&2
  fi
  exit 1
fi

# Report on stderr, one summary line on stdout.
SUMMARY="$(docker run --rm \
  --user "$(id -u):$(id -g)" \
  -v "${ENV_DIR}:/work" -w /work \
  --entrypoint /nodejs/bin/node \
  "${IMAGE}" /app/dist/index-swarm/cli/setup.js --file "/work/${ENV_NAME}" \
  ${ARGS[@]+"${ARGS[@]}"})"

for arg in ${ARGS[@]+"${ARGS[@]}"}; do
  case "${arg}" in --dry-run|-h|--help) exit 0 ;; esac
done

RESTART_CORE=0
PROFILES=""
SERVICES=""
for field in ${SUMMARY}; do
  case "${field}" in
    core=*) RESTART_CORE="${field#core=}" ;;
    profiles=*) PROFILES="${field#profiles=}" ;;
    services=*) SERVICES="${field#services=}" ;;
  esac
done

# The compose files the running gateway was started with, so override files
# (log rotation, local tweaks) are kept, plus docker-compose.override.yaml
# if it is not among them. Without a running gateway, compose's own defaults
# (docker-compose.yaml plus docker-compose.override.yaml).
COMPOSE=(docker compose)
# The file just edited is the one compose must read.
if [[ "${ENV_REAL}" != "$(realpath -m .env)" ]]; then
  COMPOSE+=(--env-file "${ENV_FILE}")
fi
CORE_CONTAINER="$(docker ps -q \
  --filter "label=com.docker.compose.service=core" \
  --filter "label=com.docker.compose.project.working_dir=$(pwd)" | head -n1)"
if [[ -n "${CORE_CONTAINER}" ]]; then
  FILES="$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.project.config_files" }}' "${CORE_CONTAINER}")"
  IFS=',' read -r -a FILE_LIST <<<"${FILES}"
  for file in "${FILE_LIST[@]}"; do COMPOSE+=(-f "${file}"); done
  # An override written since the gateway was created (turning the engine
  # off recreates only the sidecar) is missing from core's label, and a plain
  # `docker compose up` would load it.
  for override in docker-compose.override.yaml docker-compose.override.yml; do
    [[ -f "${override}" ]] || continue
    listed=false
    for file in "${FILE_LIST[@]}"; do
      [[ "$(realpath -m "${file}")" == "$(realpath -m "${override}")" ]] && listed=true
    done
    if [[ "${listed}" != true ]]; then
      echo "index-swarm-setup: also reading ${override}, which the running gateway was started without" >&2
      COMPOSE+=(-f "$(pwd)/${override}")
    fi
  done
fi
# The gateway also needs recreating when it runs with values older than the
# file's, as after an earlier run without --restart.
env_value() {
  sed -n "s/^$1=//p" "${ENV_FILE}" | tail -n1 |
    sed -E "s/^'(.*)'[[:space:]]*$/\1/; t; s/^\"(.*)\"[[:space:]]*$/\1/; t; s/[[:space:]]+#.*$//"
}
if [[ -n "${CORE_CONTAINER}" && "${RESTART_CORE}" != 1 ]]; then
  RUNNING_ENV="$(docker inspect -f '{{ range .Config.Env }}{{ println . }}{{ end }}' "${CORE_CONTAINER}")"
  for key in CDB64_ROOT_TX_INDEX_SOURCES ROOT_TX_LOOKUP_ORDER L1_BAND_IMPORT_ENABLED; do
    running="$(sed -n "s/^${key}=//p" <<<"${RUNNING_ENV}" | tail -n1)"
    if [[ "${running}" != "$(env_value "${key}")" ]]; then RESTART_CORE=1; fi
  done
fi

PROFILE_ARGS=()
IFS=',' read -r -a PROFILE_LIST <<<"${PROFILES}"
for profile in "${PROFILE_LIST[@]}"; do PROFILE_ARGS+=(--profile "${profile}"); done
IFS=',' read -r -a PLANNED_LIST <<<"${SERVICES}"
# Only the planned services this node's compose files enable. Compose starts
# a service named on the command line even when its profile is off, so an
# engine put behind an unused profile (HTTP-only sharing, see "Turning it
# off" in docs/index-swarm.md) would otherwise come back. `config --services`
# lists what a plain `up` starts with the same files (COMPOSE_PROFILES
# applies). The planned profile flags are not counted: setup always passes
# the old index-swarm names, which would re-enable an engine parked behind
# one. Only index-export, which a publisher's plan adds with its profile, is
# judged with that profile on.
if ! ENABLED="$("${COMPOSE[@]}" config --services)"; then
  echo "index-swarm-setup: docker compose config failed; nothing restarted" >&2
  exit 1
fi
SERVICE_LIST=()
for service in "${PLANNED_LIST[@]}"; do
  enabled="${ENABLED}"
  if [[ "${service}" == index-export ]]; then
    if ! enabled="$("${COMPOSE[@]}" --profile index-export config --services)"; then
      echo "index-swarm-setup: docker compose config failed; nothing restarted" >&2
      exit 1
    fi
  fi
  if grep -qxF "${service}" <<<"${enabled}"; then
    SERVICE_LIST+=("${service}")
  else
    echo "index-swarm-setup: ${service} is off in the compose files; leaving it alone" >&2
  fi
done

core_cmd="${COMPOSE[*]} up -d --no-deps core"
swarm_cmd=""
if [[ ${#SERVICE_LIST[@]} -gt 0 ]]; then
  swarm_cmd="${COMPOSE[*]} ${PROFILE_ARGS[*]} up -d --no-deps ${SERVICE_LIST[*]}"
fi

if [[ "${RESTART}" != true ]]; then
  if [[ "${RESTART_CORE}" == 1 || -n "${swarm_cmd}" ]]; then
    echo >&2
    echo "To apply it:" >&2
    [[ "${RESTART_CORE}" == 1 ]] && echo "  ${core_cmd}" >&2
    [[ -n "${swarm_cmd}" ]] && echo "  ${swarm_cmd}" >&2
    echo "Or run this again with --restart. Then check it: ./tools/index-swarm-status" >&2
  fi
  exit 0
fi

if [[ "${RESTART_CORE}" == 1 ]]; then
  echo >&2
  echo "Recreating the gateway (it reads the new index sources)..." >&2
  "${COMPOSE[@]}" up -d --no-deps core
  # Wait for it, so the sidecar's release check finds it up.
  NEW_CORE="$(docker ps -q \
    --filter "label=com.docker.compose.service=core" \
    --filter "label=com.docker.compose.project.working_dir=$(pwd)" | head -n1)"
  for _ in $(seq 1 60); do
    health="$(docker inspect -f '{{ if .State.Health }}{{ .State.Health.Status }}{{ else }}{{ .State.Status }}{{ end }}' "${NEW_CORE}" 2>/dev/null || true)"
    [[ "${health}" == healthy || "${health}" == running ]] && break
    sleep 5
  done
  echo "Gateway: ${health:-unknown}" >&2
fi

if [[ ${#SERVICE_LIST[@]} -gt 0 ]]; then
  echo >&2
  echo "Starting ${SERVICE_LIST[*]}..." >&2
  "${COMPOSE[@]}" "${PROFILE_ARGS[@]}" up -d --no-deps "${SERVICE_LIST[@]}"
fi
echo >&2
echo "Done. In a few minutes, check it: ./tools/index-swarm-status" >&2
