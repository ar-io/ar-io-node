#!/usr/bin/env bash

# AR.IO Gateway - Automated ClickHouse Import Pipeline
# This script continuously exports data from AR.IO SQLite databases to Parquet format
# with Iceberg-compatible structure and imports it to ClickHouse.
# 
# Uses a two-step approach:
# 1. parquet-export script to export data to Parquet files with Iceberg-compatible partitioning
# 2. clickhouse-import script to import the Parquet files to ClickHouse database
# 
# The exported Parquet files are stored with Iceberg-compatible partitioning in the datasets directory.

# Load common library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

set -euo pipefail

# Load environment and API key
load_env
load_admin_api_key
load_clickhouse_config

# Set local variables with defaults
ar_io_host=${AR_IO_HOST:-localhost}
ar_io_port=${AR_IO_PORT:-4000}
dataset_dir="${LOCAL_DATASETS_PATH:-./data/datasets}/default"
staging_dir="${ETL_STAGING_PATH:-./data/etl/staging}"
sleep_interval=${CLICKHOUSE_AUTO_IMPORT_SLEEP_INTERVAL:-3600} # Export every hour by default
height_interval=${CLICKHOUSE_AUTO_IMPORT_HEIGHT_INTERVAL:-10000}
max_rows_per_file=${CLICKHOUSE_AUTO_IMPORT_MAX_ROWS_PER_FILE:-1000000}
core_db_path="${CORE_DB_PATH:-data/sqlite/core.db}"
bundles_db_path="${BUNDLES_DB_PATH:-data/sqlite/bundles.db}"

# sqlite3 powers the pre-batch empty-range check below. If it's missing we
# disable the skip optimization rather than failing — the pipeline still
# works, it just spends time exporting empty ranges the way it used to.
skip_empty_batches=true
if ! command -v sqlite3 >/dev/null 2>&1; then
    echo "Warning: sqlite3 not available; empty-range skip optimization disabled." >&2
    skip_empty_batches=false
fi

# Returns 0 when any of the three source tables has at least one row in
# [start, end]; 1 otherwise. Every error path — missing DB file, query
# failure, or corrupted output — fails open by returning 0 so the batch
# still runs. Silently skipping a populated range is far worse than
# wasting an export on an empty one.
missing_db_warned_core=""
missing_db_warned_bundles=""
batch_has_data() {
    local start=$1
    local end=$2
    local found rc

    if [ ! -f "$core_db_path" ]; then
        if [ -z "$missing_db_warned_core" ]; then
            echo "Warning: core DB not found at $core_db_path; empty-range skip will fail open (assume data present)." >&2
            missing_db_warned_core=1
        fi
        return 0
    fi

    found=$(sqlite3 "$core_db_path" \
        "SELECT 1 FROM stable_blocks WHERE height >= $start AND height <= $end LIMIT 1;" 2>/dev/null)
    rc=$?
    if [ $rc -ne 0 ]; then return 0; fi
    [ "$found" = "1" ] && return 0

    found=$(sqlite3 "$core_db_path" \
        "SELECT 1 FROM stable_transactions WHERE height >= $start AND height <= $end LIMIT 1;" 2>/dev/null)
    rc=$?
    if [ $rc -ne 0 ]; then return 0; fi
    [ "$found" = "1" ] && return 0

    if [ ! -f "$bundles_db_path" ]; then
        if [ -z "$missing_db_warned_bundles" ]; then
            echo "Warning: bundles DB not found at $bundles_db_path; empty-range skip will fail open (assume data present)." >&2
            missing_db_warned_bundles=1
        fi
        return 0
    fi

    found=$(sqlite3 "$bundles_db_path" \
        "SELECT 1 FROM stable_data_items WHERE height >= $start AND height <= $end LIMIT 1;" 2>/dev/null)
    rc=$?
    if [ $rc -ne 0 ]; then return 0; fi
    [ "$found" = "1" ] && return 0

    return 1
}

# Check critical preconditions
if [ -z "${ADMIN_API_KEY:-}" ]; then
    echo "Error: Either no ADMIN_API_KEY environment variable set in .env or no ADMIN_API_KEY_FILE path provided"
    exit 1
fi

# Check that parquet-export script exists
if [ ! -x "./scripts/parquet-export" ]; then
    echo "Error: ./scripts/parquet-export not found or not executable"
    exit 1
fi

# Create directories
mkdir -p "$dataset_dir"

# ------------------------------------------------------------------------------
# SWITCH OFF 'exit on error' so the script doesn't die in the main loop
# ------------------------------------------------------------------------------
set +e

# Tracked across cycles for replay detection.
prev_cycle_first_bucket=""

while true; do
    loop_start_time=$(date +%s)
    echo "Starting new import cycle at $(date)"

    # Per-cycle batch outcome counters (emitted at cycle end).
    cycle_batches=0
    cycle_ok=0
    cycle_export_failed=0
    cycle_import_failed=0
    cycle_prune_failed=0
    cycle_prune_unverified=0
    cycle_debug_failed=0
    cycle_skipped_empty=0

    # Refresh operator TTL rules before importing new partitions. The loader
    # exits 0 for missing/malformed files and leaves any previously loaded
    # rules in place. A non-zero exit means ClickHouse rejected a write
    # mid-load; the loader best-effort clears rule tables and retries the
    # dictionary reload, but the final state of the exact-match dictionaries
    # isn't guaranteed — the loader's stderr distinguishes "cleaned" vs
    # "stale-dictionaries" cases.
    if [ -n "${CLICKHOUSE_TTL_RULES_PATH:-}" ] && [ -f "$CLICKHOUSE_TTL_RULES_PATH" ]; then
        echo "Loading TTL rules from $CLICKHOUSE_TTL_RULES_PATH..."
        ttl_load_start=$(date +%s)
        if python3 "$SCRIPT_DIR/clickhouse-load-ttl-rules.py" "$CLICKHOUSE_TTL_RULES_PATH"; then
            log_timing "Load TTL rules" "$ttl_load_start" "$(date +%s)"
        else
            echo "Warning: TTL rules load failed; TTL state may be partially stale for this cycle (see loader output above)."
            log_timing "Load TTL rules (failed)" "$ttl_load_start" "$(date +%s)"
        fi
    else
        echo "No TTL rules file at ${CLICKHOUSE_TTL_RULES_PATH:-<unset>}; skipping TTL load."
    fi

    echo "Attempting to fetch debug info from admin endpoint..."
    fetch_debug_start_time=$(date +%s)
    debug_info="$(curl -s --fail --show-error -H "Authorization: Bearer $ADMIN_API_KEY" "http://${ar_io_host}:${ar_io_port}/ar-io/admin/debug")"
    curl_status=$?
    fetch_debug_end_time=$(date +%s)

    # If curl fails or returns non-200, skip this iteration
    if [ $curl_status -ne 0 ] || [ -z "$debug_info" ]; then
        log_timing "Fetch debug info (failed)" "$fetch_debug_start_time" "$fetch_debug_end_time"
        echo "Warning: Failed to get debug info or received empty response. Skipping this iteration."
        sleep 10
        continue
    fi
    log_timing "Fetch debug info" "$fetch_debug_start_time" "$fetch_debug_end_time"

    # Parse debug info
    min_height="$(echo "$debug_info" | jq -r '.db.heights.minStableDataItem' 2>/dev/null)"
    max_height="$(echo "$debug_info" | jq -r '.db.heights.maxStableDataItem' 2>/dev/null)"
    max_indexed_at="$(echo "$debug_info" | jq -r '.db.timestamps.maxStableDataItemIndexedAt' 2>/dev/null)"

    # If jq parsing failed or the fields are empty, skip this iteration
    if [ -z "$min_height" ] || [ -z "$max_height" ] || [ -z "$max_indexed_at" ] || [ "$min_height" = "null" ] || [ "$max_height" = "null" ]; then
        echo "Warning: Debug info missing expected fields or invalid JSON. Skipping this iteration."
        sleep 10
        continue
    fi

    # Align to intervals of 10,000
    current_height=$(((min_height / height_interval) * height_interval))

    # Replay detection: same starting bucket as previous cycle means prune
    # isn't advancing minStableDataItem past the first bucket.
    if [ -n "$prev_cycle_first_bucket" ] && [ "$current_height" -eq "$prev_cycle_first_bucket" ]; then
        echo "METRIC cycle_replay bucket=$current_height"
    fi
    prev_cycle_first_bucket="$current_height"

    # Inner loop for heights
    height_process_start_time=$(date +%s)
    while [ "$current_height" -le "$max_height" ]; do
        batch_start_time=$(date +%s)
        echo "-------------------------------------------"
        echo "Starting batch at $(date)"
        end_height=$((current_height + height_interval - 1))

        echo "Processing heights $current_height to $end_height..."

        # Per-batch stage outcomes (for the METRIC batch_result line).
        export_stage="skipped"
        import_stage="skipped"
        prune_stage="skipped"
        post_prune_min_stable=""
        batch_result="unknown"

        # Step 0: Refresh debug info for this batch so the prune threshold
        # is taken *before* this batch's export runs. The export will see
        # at least every item with indexed_at <= batch_max_indexed_at, so
        # using that same value for the subsequent prune call guarantees
        # prune can never remove un-exported items.
        batch_debug_start_time=$(date +%s)
        batch_debug_info="$(curl -s --fail --show-error -H "Authorization: Bearer $ADMIN_API_KEY" "http://${ar_io_host}:${ar_io_port}/ar-io/admin/debug")"
        batch_debug_status=$?
        log_timing "Fetch per-batch debug info" "$batch_debug_start_time" "$(date +%s)"

        if [ $batch_debug_status -ne 0 ] || [ -z "$batch_debug_info" ]; then
            echo "Warning: Per-batch debug fetch failed; skipping batch $current_height-$end_height."
            batch_result="debug_failed"
            cycle_batches=$((cycle_batches + 1))
            cycle_debug_failed=$((cycle_debug_failed + 1))
            echo "METRIC batch_result range=${current_height}-${end_height} export=skipped import=skipped prune=skipped post_prune_min_stable= result=debug_failed duration_s=$(( $(date +%s) - batch_start_time ))"
            current_height=$((end_height + 1))
            continue
        fi

        batch_max_indexed_at="$(echo "$batch_debug_info" | jq -r '.db.timestamps.maxStableDataItemIndexedAt' 2>/dev/null)"
        pre_prune_min_stable="$(echo "$batch_debug_info" | jq -r '.db.heights.minStableDataItem' 2>/dev/null)"

        if [ -z "$batch_max_indexed_at" ] || [ "$batch_max_indexed_at" = "null" ] || [ -z "$pre_prune_min_stable" ] || [ "$pre_prune_min_stable" = "null" ]; then
            echo "Warning: Per-batch debug info missing fields; skipping batch $current_height-$end_height."
            batch_result="debug_failed"
            cycle_batches=$((cycle_batches + 1))
            cycle_debug_failed=$((cycle_debug_failed + 1))
            echo "METRIC batch_result range=${current_height}-${end_height} export=skipped import=skipped prune=skipped post_prune_min_stable= result=debug_failed duration_s=$(( $(date +%s) - batch_start_time ))"
            current_height=$((end_height + 1))
            continue
        fi

        # Skip ranges with no source rows. With sparse backfills most
        # buckets between min/maxStableDataItem are empty, and attempting
        # export/import for them just produces "Input directory does not
        # exist" noise or 0-byte parquet files. Nothing in an empty range
        # needs pruning either, so skipping is safe.
        if [ "$skip_empty_batches" = true ] && ! batch_has_data "$current_height" "$end_height"; then
            echo "Skipping empty range $current_height-$end_height (no blocks, transactions, or data items)."
            batch_result="skipped_empty"
            cycle_batches=$((cycle_batches + 1))
            cycle_skipped_empty=$((cycle_skipped_empty + 1))
            echo "METRIC batch_result range=${current_height}-${end_height} export=skipped import=skipped prune=skipped post_prune_min_stable= result=skipped_empty duration_s=$(( $(date +%s) - batch_start_time ))"
            current_height=$((end_height + 1))
            continue
        fi

        # Generate job staging directory for this batch
        job_id="$(date +%Y%m%d_%H%M%S)_$$"
        job_staging_dir="$staging_dir/job-${current_height}-${end_height}-${job_id}"
        
        # Step 1: Export to Parquet format in staging
        echo "Starting Parquet export..."
        export_start_time=$(date +%s)
        
        # Run parquet-export script with staging-based workflow
        # Note: L2 transactions (data items) are included by default, only L1 needs explicit inclusion
        ./scripts/parquet-export \
            --start-height "$current_height" \
            --end-height "$end_height" \
            --height-partition-size "$height_interval" \
            --staging-job-dir "$job_staging_dir" \
            --output-dir "$dataset_dir" \
            --max-file-rows "$max_rows_per_file" \
            --api-host "$ar_io_host" \
            --api-port "$ar_io_port"
        
        export_status=$?
        export_complete_time=$(date +%s)
        
        if [ $export_status -eq 0 ]; then
            # The parquet-export script now verifies OUTPUT_DIR exists before
            # exiting 0, but double-check here in case an older script version
            # is in use.
            if [ ! -d "$job_staging_dir" ]; then
                echo "Warning: Parquet export reported success but staging dir is missing: $job_staging_dir"
                echo "         This usually indicates a concurrent export race or an aborted worker."
                log_timing "Export to parquet (missing dir)" "$export_start_time" "$export_complete_time"
                export_success=false
                export_stage="failed"
            else
                echo "Parquet export completed successfully."
                log_timing "Export to parquet" "$export_start_time" "$export_complete_time"
                export_success=true
                export_stage="ok"
            fi
        else
            echo "Warning: Parquet export failed with exit status $export_status for range $current_height-$end_height"
            log_timing "Export to parquet (failed)" "$export_start_time" "$export_complete_time"
            export_success=false
            export_stage="failed"
        fi

        # Step 2: Import to ClickHouse from staging if export succeeded
        if [ "$export_success" = true ]; then
            echo "Starting ClickHouse import from staging..."
            import_start_time=$(date +%s)
            
            # Generate partition name matching the height range format
            partition_name="height=${current_height}-${end_height}"
            
            import_args=(--input-dir "$job_staging_dir" --partition "$partition_name")
            [ -n "${CLICKHOUSE_HOST:-}" ]     && import_args+=(--clickhouse-host "$CLICKHOUSE_HOST")
            [ -n "${CLICKHOUSE_PORT:-}" ]     && import_args+=(--clickhouse-port "$CLICKHOUSE_PORT")
            [ -n "${CLICKHOUSE_USER:-}" ]     && import_args+=(--clickhouse-user "$CLICKHOUSE_USER")
            [ -n "${CLICKHOUSE_PASSWORD:-}" ] && import_args+=(--clickhouse-password "$CLICKHOUSE_PASSWORD")
            ./scripts/clickhouse-import "${import_args[@]}"
            
            import_status=$?
            import_complete_time=$(date +%s)
            
            if [ $import_status -eq 0 ]; then
                echo "ClickHouse import completed successfully."
                log_timing "ClickHouse import" "$import_start_time" "$import_complete_time"
                import_success=true
                import_stage="ok"
                
                # Step 3: Move from staging to dataset directory after successful import
                echo "Moving files from staging to dataset directory..."
                move_start_time=$(date +%s)
                
                for table in blocks transactions tags; do
                    if [ -d "$job_staging_dir/$table/data" ]; then
                        mkdir -p "$dataset_dir/$table/data"
                        mv "$job_staging_dir/$table/data"/* "$dataset_dir/$table/data/" 2>/dev/null || true
                    fi
                done
                
                move_complete_time=$(date +%s)
                log_timing "Move staging to dataset" "$move_start_time" "$move_complete_time"
                
                # Step 3.5: Update Iceberg metadata for new partitions (disabled by default)
                if [ "${ENABLE_ICEBERG_GENERATION:-false}" = "true" ]; then
                    if ! command -v python3 >/dev/null 2>&1 || [ ! -f ./scripts/generate-iceberg-metadata ]; then
                        echo "Warning: Iceberg generation enabled but Python3 or script not available"
                    else
                        echo "Updating Iceberg metadata..."
                        iceberg_start_time=$(date +%s)

                        # Build datasets root based on ARNS_ROOT_HOST if configured
                        iceberg_args=(
                            "--datasets-dir" "$dataset_dir"
                        )

                        # Add ARNS datasets root if configured
                        if [ -n "${ARNS_ROOT_HOST:-}" ]; then
                            datasets_root="https://${ARNS_ROOT_HOST}/local/datasets/default"
                            iceberg_args+=("--datasets-root" "$datasets_root")
                            echo "  Using ARNS datasets root: $datasets_root"
                        fi

                        # Run the metadata generation
                        python3 ./scripts/generate-iceberg-metadata "${iceberg_args[@]}"
                        iceberg_status=$?
                        iceberg_complete_time=$(date +%s)

                        if [ $iceberg_status -eq 0 ]; then
                            echo "Iceberg metadata updated successfully."
                            log_timing "Iceberg metadata generation" "$iceberg_start_time" "$iceberg_complete_time"
                        else
                            echo "Warning: Iceberg metadata generation failed (non-critical, continuing)"
                            log_timing "Iceberg metadata generation (failed)" "$iceberg_start_time" "$iceberg_complete_time"
                        fi
                    fi
                fi
                
                # Clean up staging directory after successful move
                rm -rf "$job_staging_dir"
                echo "Staging directory cleaned up."
                
            else
                echo "Warning: ClickHouse import failed with status $import_status"
                echo "Staging files preserved at: $job_staging_dir"
                log_timing "ClickHouse import (failed)" "$import_start_time" "$import_complete_time"
                import_success=false
                import_stage="failed"
            fi
        else
            echo "Skipping ClickHouse import because Parquet export failed."
            import_success=false
        fi

        # Step 4: Prune stable data items (only if import succeeded).
        # Uses $batch_max_indexed_at captured BEFORE this batch's export, so
        # the prune threshold is never newer than what the export snapshot saw.
        if [ "$import_success" = true ]; then
            echo "Pruning stable data items from height $current_height to $end_height..."
            prune_start_time=$(date +%s)
            curl -s --fail --show-error -X POST "http://${ar_io_host}:${ar_io_port}/ar-io/admin/prune-stable-data-items" \
                -H "Authorization: Bearer $ADMIN_API_KEY" \
                -H "Content-Type: application/json" \
                -d "{
                    \"indexedAtThreshold\": $batch_max_indexed_at,
                    \"startHeight\": $current_height,
                    \"endHeight\": $end_height
                }"
            prune_status=$?
            prune_end_time=$(date +%s)
            if [ $prune_status -ne 0 ]; then
                log_timing "Prune stable data items (failed)" "$prune_start_time" "$prune_end_time"
                echo "Warning: Prune request failed. Continuing to next batch."
                prune_stage="failed"
            else
                log_timing "Prune stable data items" "$prune_start_time" "$prune_end_time"

                # Post-prune verification: re-fetch debug and compare
                # minStableDataItem against this batch's end_height and the
                # pre-prune value. Purely observational.
                verify_debug_info="$(curl -s --fail --show-error -H "Authorization: Bearer $ADMIN_API_KEY" "http://${ar_io_host}:${ar_io_port}/ar-io/admin/debug")"
                verify_status=$?
                if [ $verify_status -ne 0 ] || [ -z "$verify_debug_info" ]; then
                    echo "Warning: Post-prune debug fetch failed; cannot verify prune for $current_height-$end_height."
                    prune_stage="unverified"
                else
                    post_prune_min_stable="$(echo "$verify_debug_info" | jq -r '.db.heights.minStableDataItem' 2>/dev/null)"
                    if [ -z "$post_prune_min_stable" ] || [ "$post_prune_min_stable" = "null" ]; then
                        echo "Warning: Post-prune debug missing minStableDataItem; cannot verify."
                        prune_stage="unverified"
                        post_prune_min_stable=""
                    elif [ "$pre_prune_min_stable" -gt "$end_height" ]; then
                        prune_stage="already_drained"
                    elif [ "$post_prune_min_stable" -gt "$end_height" ]; then
                        prune_stage="ok"
                    elif [ "$post_prune_min_stable" -gt "$pre_prune_min_stable" ]; then
                        echo "Warning: Prune partial for $current_height-$end_height: minStableDataItem advanced $pre_prune_min_stable -> $post_prune_min_stable but still <= $end_height."
                        prune_stage="partial"
                    else
                        echo "Warning: Prune appears to be a no-op for $current_height-$end_height: minStableDataItem unchanged at $post_prune_min_stable."
                        prune_stage="noop"
                    fi
                fi
            fi
        else
            echo "Skipping pruning because import failed."
        fi

        # Compute batch_result from stage outcomes.
        if [ "$export_stage" = "failed" ]; then
            batch_result="export_failed"
        elif [ "$import_stage" = "failed" ]; then
            batch_result="import_failed"
        elif [ "$prune_stage" = "failed" ]; then
            batch_result="prune_failed"
        elif [ "$prune_stage" = "unverified" ] || [ "$prune_stage" = "noop" ]; then
            batch_result="prune_unverified"
        else
            batch_result="ok"
        fi

        # Update cycle counters.
        cycle_batches=$((cycle_batches + 1))
        case "$batch_result" in
            ok)                cycle_ok=$((cycle_ok + 1)) ;;
            export_failed)     cycle_export_failed=$((cycle_export_failed + 1)) ;;
            import_failed)     cycle_import_failed=$((cycle_import_failed + 1)) ;;
            prune_failed)      cycle_prune_failed=$((cycle_prune_failed + 1)) ;;
            prune_unverified)  cycle_prune_unverified=$((cycle_prune_unverified + 1)) ;;
        esac

        # Log batch timing + structured outcome.
        batch_end_time=$(date +%s)
        log_timing "Batch processing (heights $current_height to $end_height)" "$batch_start_time" "$batch_end_time"
        echo "METRIC batch_result range=${current_height}-${end_height} export=${export_stage} import=${import_stage} prune=${prune_stage} post_prune_min_stable=${post_prune_min_stable} result=${batch_result} duration_s=$((batch_end_time - batch_start_time))"

        # Bump current_height
        current_height=$((end_height + 1))
    done

    # Log timing for the heights processing
    height_process_end_time=$(date +%s)
    log_timing "All heights processing" "$height_process_start_time" "$height_process_end_time"

    # Log timing for the entire cycle
    loop_end_time=$(date +%s)
    log_timing "Complete import cycle" "$loop_start_time" "$loop_end_time"

    echo "METRIC cycle_summary batches=${cycle_batches} ok=${cycle_ok} skipped_empty=${cycle_skipped_empty} export_failed=${cycle_export_failed} import_failed=${cycle_import_failed} prune_failed=${cycle_prune_failed} prune_unverified=${cycle_prune_unverified} debug_failed=${cycle_debug_failed} duration_s=$((loop_end_time - loop_start_time))"

    echo "Sleeping for $sleep_interval seconds..."
    sleep "$sleep_interval"
done
